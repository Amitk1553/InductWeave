PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash          # verify current name in docs
GEMINI_EMBEDDING_MODEL=gemini-embedding-001   # also supported: gemini-embedding-2 (see docs/decisions.md)
EMBEDDING_DIMENSIONS=768               # must match the model + the vector column
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=30000
RAG_TOP_K=5
RAG_MIN_SCORE=0.35            # below this top similarity, skip the LLM and refuse
CHAT_HISTORY_TURNS=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
PROMPT_VERSION=v1.2
CORS_ORIGIN=http://localhost:5173
ESCALATION_CRON=0 * * * *

# Demo switches (optional)
FORCE_LLM_FAILURE=false                # true => every Gemini call fails, so the fallback plan path can be demonstrated
LOG_LEVEL=info
# DB_POOL_MAX=10
# DB_DRIVER=auto                       # auto | pg | neon. auto uses the WebSocket driver (port 443) for *.neon.tech hosts
# SEED_DEMO_EMAIL=you@example.com      # optional: `npm run seed` links your Clerk email to demo manager/employee records
